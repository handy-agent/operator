ANTHROPIC_API_KEY=
# Business profile: fills the agent's prompt files (app/business.py). All required.
BUSINESS_OWNER=
BUSINESS_NAME=
BUSINESS_SERVICES=
BUSINESS_SERVICE_AREA=
# Account the connected Thumbtack business's leads belong to (one business for now)
OPERATOR_ACCOUNT_ID=
# Telegram: the product bot (optional) — setup steps in sh/README.md
TELEGRAM_BOT_TOKEN=
# Production only: public base URL of this app + a random secret -> Telegram calls /webhooks/telegram.
# Leave empty locally: the app polls Telegram instead.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Timing and alarm are per-customer settings now: sh/account-settings.sh
# Record store (app/db/records.py): dynamodb or files. Locally: DynamoDB Local from sh/dynamo-local.sh.
# On AWS: leave DYNAMODB_ENDPOINT_URL empty (real DynamoDB, credentials from the IAM role).
DB_BACKEND=dynamodb
DYNAMODB_ENDPOINT_URL=http://localhost:8001
DYNAMODB_TABLE=operator
AWS_REGION=us-east-1
